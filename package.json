{
    "name": "discord-frotz-bot",
    "version": "1.0.0",
    "description": "Discord bot to interface with dfrotz",
    "main": "frotz-bot.js",
    "scripts": {
        "start": "node ./frotz-bot.js",
        "lint": "node_modules/.bin/eslint ./*.js events tests",
        "lint-fix": "node_modules/.bin/eslint ./*.js events tests --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage"
    },
    "author": "NepoKama",
    "license": "MIT",
    "dependencies": {
        "dateformat": "^5.0.3",
        "discord.js": "^14.25.1",
        "dotenv": "^18.0.9",
        "glob": "^13.0.0",
        "rezrov-zmachine": "file:../rezrov-zmachine",
        "winston": "^3.18.3"
    },
    "imports": {
        "#events/*": "./events/*",
        "#commands/*": "./events/commands/*.js"
    },
    "type": "module",
    "devDependencies": {
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
