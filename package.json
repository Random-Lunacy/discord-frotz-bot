{
    "name": "discord-frotz-bot",
    "version": "1.0.0",
    "description": "Discord bot to interface with dfrotz",
    "main": "frotz-bot.js",
    "scripts": {
        "start": "node ./frotz-bot.js",
        "lint": "node_modules/.bin/eslint ./*.js events tests",
        "lint-fix": "node_modules/.bin/eslint ./*.js events tests --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage"
    },
    "author": "NepoKama",
    "license": "MIT",
    "dependencies": {
        "@random-lunacy/rezrov-zmachine": "^1.0.0",
        "dateformat": "^5.0.3",
        "discord.js": "^14.28.1",
        "dotenv": "^18.0.10",
        "glob": "^14.0.6",
        "winston": "^3.18.3"
    },
    "imports": {
        "#events/*": "./events/*",
        "#commands/*": "./events/commands/*.js"
    },
    "type": "module",
    "devDependencies": {
        "@vitest/coverage-v8": "^5.1.1",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "vitest": "^5.1.1"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
