DISCORD_TOKEN=your-token-goes-here
GAME_FOLDER=./games
# Optional: name given to saves the player doesn't name.
# Placeholders: {game} {user} {channel} {date} {time}
#DEFAULT_SAVE_NAME={user}_{date}_{time}

# Optional: the most games that can run at once (default 10).
#MAX_GAMES=10

# Optional: days a game's thread stays open without messages before Discord archives it,
# which also stops the game (unsaved progress is lost). 1, 3 or 7 (default 7).
#THREAD_LIFETIME_DAYS=7

# Optional: minutes a game can go without a player message before it is saved (as an autosave)
# and shut down to free resources. The thread stays open; /restore brings the game back.
# 0 turns this off (default 60).
#IDLE_TIMEOUT_MINUTES=60

# Optional: only answer commands in these channels (and the threads in them). Channel IDs separated
# by commas; right-click a channel with Developer Mode on to copy its ID. Empty means everywhere.
#ALLOWED_CHANNELS=
